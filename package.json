{
  "name": "ImageAuditer",
  "description": "AI-Assisted Image Refining, Segmentation & Quality Auditing Workspace",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "logo": "node .logo/main.js",
    "pocketbase": ".\\pocketbase.exe serve --http=127.0.0.1:8099",
    "python": ".venv\\Scripts\\python.exe .",
    "python:lock": ".venv\\Scripts\\python.exe -m pip freeze > requirements.lock",
    "dev:next": "next dev",
    "setup": "node scripts/setup.mjs",
    "app": "node scripts/run.mjs",
    "dev": "run-p logo pocketbase python dev:next",
    "build": "npm run logo && next build",
    "start": "run-p logo pocketbase python \"next start\"",
    "lint": "eslint",
    "pack": "tsx pack.ts",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue\""
  },
  "dependencies": {
    "@google/genai": "^2.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-react": "^5.0.4",
    "chaikin-smooth": "^1.0.4",
    "dotenv": "^17.2.3",
    "esm-potrace-wasm": "^0.5.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "marchingsquares": "^1.3.3",
    "motion": "^12.23.24",
    "next": "16.3.0",
    "pocketbase": "^0.27.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "simplify-js": "^1.2.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^6.2.3"
  }
}